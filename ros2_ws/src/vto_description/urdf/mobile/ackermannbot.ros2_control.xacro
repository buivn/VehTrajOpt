<?xml version="1.0"?>
<!-- ros2_control hardware interface for the Ackermann robot (docs/32, step
     2 of 4). Rear-wheel drive, front-wheel steering (docs/32 design
     decision) - rear wheel joints get a velocity command interface
     (traction), front steer joints get a position command interface
     (steering), front wheel spin joints are state-only (passive rolling).
     Backed by gz_ros2_control in sim, same as diffbot. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <ros2_control name="AckermannbotSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <!-- steering (front) -->
    <joint name="front_left_steer_joint">
      <command_interface name="position">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_steer_joint">
      <command_interface name="position">
        <param name="min">-0.5</param>
        <param name="max">0.5</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- traction (rear) -->
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- front wheels: passive rolling, no command interface -->
    <joint name="front_left_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="front_right_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
