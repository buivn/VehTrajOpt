<?xml version="1.0"?>
<!-- Ackermann (car-like) mobile robot: body only (docs/31, step 1 of 4).
     Chassis width matches diffbot's (docs/01); length is set to a 1.5:1
     length:width ratio (a more realistic car-like proportion than
     diffbot's ~1.33:1) rather than matching diffbot's footprint exactly -
     see the "revision" note in docs/31. No ros2_control / Gazebo wiring
     yet - that's steps 2-3. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ackermannbot">

  <xacro:arg name="use_sim" default="true"/>

  <!-- ================= geometry / mass params =================
       Width copied from diffbot.urdf.xacro; length = 1.5*width (revision,
       docs/31) for a realistic car-like aspect ratio, not diffbot's
       footprint exactly. base_mass scaled with footprint area from
       diffbot's 5.0 kg @ 0.40x0.30 so density stays constant rather than
       silently getting less dense as the box grows:
       5.0 * (0.45*0.30)/(0.40*0.30) = 5.625 kg. -->
  <xacro:property name="base_wid"   value="0.30"/>
  <xacro:property name="base_len"   value="${1.5 * base_wid}"/>  <!-- 0.45 m -->
  <xacro:property name="base_hei"   value="0.12"/>
  <xacro:property name="base_mass"  value="5.625"/>

  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width"  value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>
  <xacro:property name="wheel_zoff"   value="0.02"/>

  <!-- wheelbase/track: reuse diffbot's own "inset by one wheel radius"
       placement formula (diffbot.urdf.xacro:100-101) rather than a new
       one; track width matches diffbot's wheel_separation (same stance). -->
  <xacro:property name="wheelbase"    value="${base_len - 2*wheel_radius}"/>   <!-- 0.29 m -->
  <xacro:property name="track"        value="0.34"/>
  <xacro:property name="axle_x"       value="${base_len/2 - wheel_radius}"/>  <!-- 0.145 m -->

  <!-- steering: picked, not reused from src/GP/GPConstants.hpp's
       ROBOT_MIN/MAX_STEER_ANGLE (+-88 deg) - those are unconstrained-
       testing defaults for a 1.75 m scenario robot, not a realistic limit
       for this robot (docs/31 section 3). R_min = L/tan(delta_max) =
       0.29/tan(0.5) ~= 0.53 m (was 0.44 m before the length revision),
       still well under the maze's 1.5 m corridors. -->
  <xacro:property name="max_steer_angle" value="0.5"/>  <!-- rad, ~29 deg -->

  <!-- ================= inertia macros =================
       Identical to diffbot.urdf.xacro - copied, not shared via include,
       to keep this file self-contained for step 1 (no cross-file
       dependency yet; revisit if/when a common macros file is warranted). -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0"
               izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cyl_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+l*l)/12.0}" iyz="0"
               izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- ================= base ================= -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><box size="${base_len} ${base_wid} ${base_hei}"/></geometry>
      <material name="robot_red"><color rgba="0.85 0.2 0.15 1"/></material>
    </visual>
    <collision>
      <geometry><box size="${base_len} ${base_wid} ${base_hei}"/></geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_len}" y="${base_wid}" z="${base_hei}"/>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + wheel_zoff}"/>
  </joint>

  <!-- ================= rear (fixed, spin-only) wheels =================
       Same shape as diffbot's single wheel macro - rear wheels are not
       steered, so one joint (continuous, roll axis) is enough. -->
  <xacro:macro name="wheel" params="prefix x side_y">
    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="${x} ${side_y} ${-wheel_zoff}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="rear_left"  x="${-axle_x}" side_y="${ track/2}"/>
  <xacro:wheel prefix="rear_right" x="${-axle_x}" side_y="${-track/2}"/>

  <!-- ================= front (steered) wheels =================
       2-joint chain per wheel (docs/31 section 3): a revolute STEER joint (axis
       z, limited +-max_steer_angle) connects base_link to a small steering
       knuckle link, then a continuous SPIN joint (axis y, defined in the
       knuckle's own rotating frame) connects the knuckle to the wheel -
       steering and rolling are independent rotations and a URDF joint has
       exactly one axis, so they can't collapse into diffbot's single-joint
       wheel. Both front steer joints are independent here; whether they're
       commanded identically or with true per-wheel Ackermann angles is a
       controller decision (step 3), not a URDF one. -->
  <xacro:macro name="steer_wheel" params="prefix x side_y">
    <link name="${prefix}_steer_link">
      <xacro:cyl_inertia m="0.05" r="0.02" l="0.02"/>
    </link>

    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="base_link"/>
      <child  link="${prefix}_steer_link"/>
      <origin xyz="${x} ${side_y} ${-wheel_zoff}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-max_steer_angle}" upper="${max_steer_angle}"
             effort="10.0" velocity="4.0"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <origin rpy="1.5708 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" l="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="${prefix}_steer_link"/>
      <child  link="${prefix}_wheel"/>
      <origin xyz="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:steer_wheel prefix="front_left"  x="${axle_x}" side_y="${ track/2}"/>
  <xacro:steer_wheel prefix="front_right" x="${axle_x}" side_y="${-track/2}"/>

  <!-- No casters: diffbot's casters stabilize a 2-wheel base against
       pitching under acceleration (diffbot.urdf.xacro:84-87). A 4-wheel
       base is inherently pitch-stable - not needed here. -->

  <!-- ================= 2D lidar (docs/36) =================
       Same formula as diffbot.urdf.xacro:106-118 (inset from the front
       edge, roof-mounted); sensor spec is chassis-shape-independent, only
       base_len/base_hei differ. -->
  <link name="laser">
    <visual>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar_black"><color rgba="0.1 0.1 0.1 1"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.035" length="0.04"/></geometry></collision>
    <xacro:cyl_inertia m="0.1" r="0.035" l="0.04"/>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser"/>
    <origin xyz="${base_len/2 - 0.06} 0 ${base_hei/2 + 0.02}"/>
  </joint>

  <!-- ================= IMU (docs/36) =================
       Origin at base_link's own origin, not offset (diffbot.urdf.xacro:120-123):
       linear_acceleration should reflect true body acceleration, not a
       lever-arm/centripetal term - matters more here, since Ackermann
       steering imparts more lateral accel through corners than diff-drive's
       turn-in-place-then-arc behavior. -->
  <link name="imu_link">
    <xacro:box_inertia m="0.05" x="0.02" y="0.02" z="0.02"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- ================= ros2_control (docs/32, step 2 of 4) ================= -->
  <xacro:include filename="$(find vto_description)/urdf/mobile/ackermannbot.ros2_control.xacro"/>

  <!-- ================= Gazebo (docs/33, step 3 of 4) ================= -->
  <xacro:include filename="$(find vto_description)/urdf/mobile/ackermannbot.gazebo.xacro"/>

</robot>
